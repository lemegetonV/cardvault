# CardVault local configuration. `make up` copies this file to .env when .env is missing.
# Every value here is a fictional development credential for a local-only stack.

# --- Mode -----------------------------------------------------------------------------
TEST_MODE=true
TEST_KEY=cv-test-key-local
LOG_LEVEL=DEBUG

# --- Seed customers (alice, bob, charlie, dana) share one password -----------------------
SEED_USER_PASSWORD=CardVault-Demo-1

# --- Postgres: one database per service, plus a read-only role per database for tests --
POSTGRES_PASSWORD=cv-postgres-local
AUTH_DB_PASSWORD=cv-auth-local
CARD_DB_PASSWORD=cv-card-local
ENROLLMENT_DB_PASSWORD=cv-enrollment-local
WALLET_TXN_DB_PASSWORD=cv-wallet-txn-local
PROFILE_DB_PASSWORD=cv-profile-local
TESTSUPPORT_DB_PASSWORD=cv-testsupport-local
READONLY_DB_PASSWORD=cv-readonly-local

# Read-only connection strings for tests running on the host (role <db>_ro):
#   postgresql://auth_ro:cv-readonly-local@127.0.0.1:5432/auth
#   postgresql://card_ro:cv-readonly-local@127.0.0.1:5432/card
#   postgresql://enrollment_ro:cv-readonly-local@127.0.0.1:5432/enrollment
#   postgresql://wallet_txn_ro:cv-readonly-local@127.0.0.1:5432/wallet_txn
#   postgresql://profile_ro:cv-readonly-local@127.0.0.1:5432/profile
#   postgresql://testsupport_ro:cv-readonly-local@127.0.0.1:5432/testsupport

# --- Service-to-service keys: one per caller (X-Service-Key) ---------------------------
SERVICE_KEY_NETWORK_MOCK=cv-svc-network-mock-local
SERVICE_KEY_OPERATOR_MOCK=cv-svc-operator-mock-local
SERVICE_KEY_TESTS=cv-svc-tests-local

# --- JWT --------------------------------------------------------------------------------
JWT_ISSUER=cardvault-auth
JWT_AUDIENCE=cardvault

# --- Kafka (Redpanda) -------------------------------------------------------------------
# Inside the Docker network: redpanda:9092. From the host: 127.0.0.1:19092.
KAFKA_BOOTSTRAP_HOST=127.0.0.1:19092
# Topics: card.lifecycle, contact.updated, enrollment.changed, auth.decided, txn.cleared
# DLQs:   enrollment.dlq, wallet.txn.dlq

# --- Relay and consumer backoff (real time). Unset = fast defaults under TEST_MODE -------
# RELAY_BACKOFF_BASE_SECONDS=0.2
# RELAY_BACKOFF_FACTOR=2
# RELAY_BACKOFF_CAP_SECONDS=2
# HTTP_BACKOFF_MAX_ATTEMPTS=5
